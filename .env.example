APP_NAME="Sistem Antrian"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_antrian
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ---- Antrian: penguncian loket ----
# Loket otomatis dilepas bila operatornya idle (browser ditutup/koneksi putus)
# melebihi jumlah menit ini. Set 0 untuk mematikan auto-release.
LOKET_IDLE_TIMEOUT=15
# Interval (detik) panel operator mengirim heartbeat "masih aktif".
LOKET_HEARTBEAT_INTERVAL=60

# ---- Broadcasting: Laravel Reverb (WebSocket) ----
BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=local
# Queue (biar broadcast async; boleh 'sync' untuk uji cepat)
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Laravel Reverb ----
REVERB_APP_ID=antrian-app
REVERB_APP_KEY=antriankey123
REVERB_APP_SECRET=antriansecret123
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Dipakai jika frontend di-bundle lewat Vite (opsional; halaman ini memakai CDN)
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
